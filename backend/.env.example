# PostgreSQL connection string
DATABASE_URL=
# JWT signing secret (min. 32 characters). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
PORT=3001
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Public URL of the web app, used in links inside calendar invites and certificates
FRONTEND_URL=http://localhost:5173
# Max JSON request body size (photos are currently sent inline as base64)
REQUEST_BODY_LIMIT=10mb
# Set to "production" to disable Swagger docs
NODE_ENV=development
# --- Activity trail ---
# HMAC key for the tamper-evident activity log (min. 32 chars). If unset, a key is derived from JWT_SECRET.
ACTIVITY_LOG_KEY=
# --- Notifications ---
# SMTP (any provider). Leave SMTP_HOST empty in development: emails are written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=5S Platform <no-reply@example.com>
# Reminder / escalation scan interval in minutes (0 disables the scheduler)
NOTIFICATION_SCAN_MINUTES=15
# Background creation of recurring audits (minutes between passes; 0 disables)
SCHEDULE_GENERATION_MINUTES=60
# The daily digest hour and time zone are per-organization settings (Settings → Escalation)
# Mobile push via Expo ("off" disables); EXPO_ACCESS_TOKEN only if Expo push security is enabled
PUSH_NOTIFICATIONS=on
EXPO_ACCESS_TOKEN=
# --- File storage ---
# disk (default, files under STORAGE_DISK_PATH) or s3 (AWS S3 / MinIO / R2 / any S3-compatible store)
STORAGE_DRIVER=disk
STORAGE_DISK_PATH=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of this API, used in signed file links (e.g. https://api.example.com)
PUBLIC_API_URL=http://localhost:3001
# Secret for signed file links (min. 32 chars). If unset, derived from JWT_SECRET.
FILE_URL_SECRET=
# --- Security ---
# Requests per minute per client IP (global) and for sign-in / password-reset endpoints
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=10
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
# Set when running behind a reverse proxy / load balancer (e.g. 1, loopback, true) so client IPs come from X-Forwarded-For
TRUST_PROXY=
# Key encrypting TOTP secrets at rest (min. 32 chars). If unset, derived from JWT_SECRET.
MFA_ENCRYPTION_KEY=
# --- Subscriptions (plans are managed in the platform console; no payment gateway) ---
DEFAULT_PLAN_CODE=PROFESSIONAL
TRIAL_DAYS=14
# Days after the paid-through date before an organization becomes read-only
SUBSCRIPTION_GRACE_DAYS=7
# --- Integrations ---
# Seconds between webhook outbox dispatch runs (0 disables delivery)
WEBHOOK_DISPATCH_SECONDS=10
# Development only: allow webhooks to private / localhost addresses (never enable in production)
WEBHOOK_ALLOW_PRIVATE=false
