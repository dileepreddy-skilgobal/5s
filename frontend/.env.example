# Base URL of the 5S backend REST API
VITE_API_URL=http://localhost:3001/api/v1

# The "Role Portals" tab on the login page lists the seeded demo accounts and is shown by default.
# Set to false to hide it (for example on a production site where demo accounts should not be listed).
VITE_SHOW_DEMO_PORTALS=true

# Show the "SSO Login" tab. Leave false until SSO is configured on the backend
# (the SSO endpoint returns 501 Not Implemented otherwise).
VITE_SSO_ENABLED=false
